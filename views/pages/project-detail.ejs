<section class="hero page-hero detail-hero">
  <div>
    <span class="eyebrow">Project detail</span>
    <h1 class="hero-title"><%= project.title %></h1>
    <p class="hero-copy"><%= project.excerpt %></p>
    <div class="card-actions">
      <% if (project.liveUrl) { %>
        <a href="<%= project.liveUrl %>" target="_blank" rel="noreferrer" class="btn btn-primary">Visit live</a>
      <% } %>
      <% if (project.githubUrl) { %>
        <a href="<%= project.githubUrl %>" target="_blank" rel="noreferrer" class="btn btn-secondary">GitHub</a>
      <% } %>
    </div>
    <% if (project.technologies && project.technologies.length) { %>
      <div class="pill-row" style="margin-top:1rem;">
        <% project.technologies.forEach((tech) => { %>
          <span class="pill"><%= tech %></span>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div>
    <% if (project.image && project.image.url) { %>
      <img class="detail-image" src="<%= project.image.url %>" alt="<%= project.title %>">
    <% } %>
  </div>
</section>

<section class="section">
  <div class="content-card markdown" data-reveal>
    <h2>Overview</h2>
    <p><%= project.description %></p>
  </div>
</section>

